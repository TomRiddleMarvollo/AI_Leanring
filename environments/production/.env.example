# ── Production — template ───────────────────────────────────
# Copy to `.env` in this same directory and fill in real values.
# `.env` itself is gitignored — never commit real secrets.
ENV=production

# Postgres — POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB must match the
# credentials embedded in DATABASE_URL below. docker-compose.yml's `db`
# service reads the POSTGRES_* vars directly to initialize the database
# on first start; without them Postgres refuses to start at all.
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aihub_prod

# Backend
DATABASE_URL=postgresql://prod_user:CHANGE_ME@db:5432/aihub_prod
ALLOWED_ORIGINS=https://yourdomain.com
MODEL_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
OLLAMA_HOST=http://host.docker.internal:11434
DEFAULT_MODEL=gpt-oss:20b

# Frontend
VITE_API_URL=https://api.yourdomain.com
VITE_ENV=production
