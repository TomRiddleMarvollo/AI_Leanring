# ── Development ──────────────────────────────────────────────
ENV=development

# Backend
DATABASE_URL=sqlite:///./data/dev.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MODEL_PROVIDER=gemini
# Điền key riêng của bạn ở đây, KHÔNG commit key thật.
# Lưu ý: docker-compose env_file KHÔNG tự bỏ comment cuối dòng như shell —
# để trống đúng nghĩa thì để giá trị rỗng, đừng viết "= # ghi chú" trên
# cùng 1 dòng (chuỗi comment sẽ bị coi là giá trị thật của biến).
GEMINI_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
DEFAULT_MODEL=gpt-oss:20b
# Used by `make dev-local` (runs on host, not in the Docker network).
# `make dev` overrides this to http://searxng:8080 in docker-compose.yml.
SEARXNG_URL=http://localhost:8888

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_ENV=development
