# ── Test ─────────────────────────────────────────────────────
ENV=test

# Backend — PostgreSQL test DB (spun up by docker-compose.test.yml)
DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/aihub_test
ALLOWED_ORIGINS=http://localhost:5173
MODEL_PROVIDER=gemini
GEMINI_API_KEY=          # key test hoặc mock
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=gpt-oss:20b

# Frontend
VITE_API_URL=http://localhost:8000
VITE_ENV=test
